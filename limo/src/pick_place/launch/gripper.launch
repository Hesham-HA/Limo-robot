<?xml version="1.0"?>
<launch>
    <node name="mobile_gripper" pkg="pick_place" type="mobile_gripper" output="screen">
        <param name="rosconsole_logger_levels" value="moveit_task_constructor=DEBUG, moveit_ros_planning=INFO, moveit_core=INFO"/>
        <remap from="/object_bounding_boxes" to="/detection/object" />
        <param name="bbox_scale_factor" value="0.80" />
        <param name="use_scene_object" value="true" />
        <param name="object_name" value="detected_object" />
        <param name="table_name" value="detected_table" />
        <param name="zero_state_name" value="zero" />
        <param name="top_grip_state_name" value="top_grip" />
        <param name="front_grip_state_name" value="front_grip" />
        <param name="arm_group" value="arm" />
        <param name="gripper_group" value="gripper" />
        <param name="grasp_joint" value="grasping_frame_joint" />
    </node>
</launch>