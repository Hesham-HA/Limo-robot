<?xml version="1.0"?>
<launch>
    <arg name="use_rviz" default="true"/>
    <arg name="map_file" default="$(find pick_place)/maps/office_map.yaml"/>
    <arg name="map_frame_id" default="map"/>
    <arg name="color_detection" default="true"/>

    <!--  ************** Navigation ***************  -->
    <include file="$(dirname)/navigation.launch">
        <arg name="use_rviz" value="false"/>
        <arg name="map_file" value="$(arg map_file)"/>
        <arg name="map_frame_id" value="$(arg map_frame_id)"/>
    </include>

    <!--  **************** Passive Graph SLAM ****************  -->
    <group ns="rtabmap">
        <node name="rtabmap" pkg="rtabmap_slam" type="rtabmap" output="screen" args="--delete_db_on_start">
            <param name="frame_id" type="string" value="base_footprint"/>
            <remap from="odom" to="/odom"/>
            <param name="subscribe_scan" type="bool" value="true"/>
            <remap from="scan" to="/limo/scan"/>
            <param name="subscribe_depth" type="bool" value="true"/>
            <remap from="rgb/image"       to="/limo/color/image_raw"/>
            <remap from="depth/image"     to="/limo/depth/image_raw"/>
            <remap from="rgb/camera_info" to="/limo/color/camera_info"/>
            <param name="rgb/image_transport"   type="string" value="compressed"/>
            <param name="depth/image_transport" type="string" value="raw"/>
            <param name="sync_queue_size" type="int" value="20"/>
            <param name="topic_queue_size" type="int" value="20"/>
            <remap from="grid_map" to="/rtabmap/grid_map"/>
            <param name="Mem/IncrementalMemory" type="string" value="true"/>
            <!-- Don't publish to the tf tree, use only for visual exploration -->
            <param name="publish_tf" type="bool" value="false"/>
        </node>
        <!-- For visualization of detected objects -->
        <node name="save_objects_example" pkg="rtabmap_demos" type="save_objects_example" output="screen">
            <param name="frame_id" value="base_footprint"/>
        </node>
    </group>

    <!--  ************** exploration ***************  -->
	<node pkg="explore_lite" type="explore" respawn="false" name="explore" output="screen">
		<param name="robot_base_frame" value="base_link"/>
		<param name="costmap_topic" value="/rtabmap/grid_map"/>
		<param name="costmap_updates_topic" value="/map_updates"/>
		<param name="visualize" value="true"/>
		<param name="planner_frequency" value="0.1"/>
		<param name="progress_timeout" value="20.0"/>
		<param name="potential_scale" value="3.0"/>
		<param name="orientation_scale" value="0.0"/>
		<param name="gain_scale" value="1.0"/>
		<param name="transform_tolerance" value="0.3"/>
		<param name="min_frontier_size" value="0.75"/>
	</node>

    <!-- Use simulation time -->
    <param name="use_sim_time" value="true"/>

    <!--  **************** feature-based Object Detection ****************  -->
    <node unless="$(arg color_detection)" name="find_object_3d" pkg="find_object_2d" type="find_object_2d" output="screen">
        <param name="gui"             value="true"/>
        <param name="subscribe_depth" value="true"/>
		<param name="approx_sync" value="false" type="bool"/>
        <param name="object_prefix" value="object" type="str"/>

        <!-- Path to object images -->
        <param name="objects_path" value="$(find pick_place)/objects/Can"/>
        <param name="settings_path" value="$(find pick_place)/config/find_object.ini"/>

        <!-- Camera topics -->
        <remap from="rgb/image_rect_color" to="/limo/color/image_raw"/>
        <remap from="depth_registered/image_raw" to="/limo/depth/image_raw"/>
        <remap from="depth_registered/camera_info" to="/limo/depth/camera_info"/>
        <param name="rgb/image_transport" value="compressed"/>
        <param name="depth_registered/image_transport" value="raw"/>
    </node>
    <node unless="$(arg color_detection)" name="object_extractor" pkg="pick_place" type="object_extractor.py" output="screen">
		<param name="object_prefix" value="object" type="str"/>
        <param name="target_frame_id" value="depth_link"/>
        <remap from="/camera/color/camera_info" to="/limo/color/camera_info" />
	</node>
    
    <!--  **************** color-based Object Detection ****************  -->
    <node if="$(arg color_detection)" name="color_detection" pkg="pick_place" type="color_detection" output="screen">
        <!-- Main settings -->
        <remap from="/camera/color/camera_info" to="/limo/color/camera_info"/>
        <remap from="/camera/color/image_raw" to="/limo/color/image_raw"/>
        <remap from="/camera/depth/image_raw" to="/limo/depth/image_raw"/>
        <param name="target_frame_id" value="depth_link"/>
        <param name="objects_path" value="$(find pick_place)/objects/colored"/>
        <!-- Color extraction parameters -->
        <param name="hsv_tolerance" value="15" type="int"/>  <!-- Hue tolerance in degrees (0-180) -->
        <param name="saturation_min" value="40" type="int"/>  <!-- Minimum saturation (0-255) -->
        <param name="value_min" value="40" type="int"/>       <!-- Minimum value/brightness (0-255) -->
        <!-- Aspect ratio matching -->
        <param name="aspect_ratio_tolerance" value="0.3" type="double"/>  <!-- 30% tolerance -->
        <!-- Confidence scoring weights (must sum to ~1.0) -->
        <param name="color_match_weight" value="0.35" type="double"/>        <!-- HSV color similarity -->
        <param name="aspect_ratio_weight" value="0.30" type="double"/>       <!-- Shape similarity -->
        <param name="area_weight" value="0.20" type="double"/>               <!-- Size preference -->
        <param name="depth_quality_weight" value="0.15" type="double"/>      <!-- Depth reliability -->
        <!-- Confidence score threshold -->
        <param name="score_threshold" value="0.7" type="double"/> 
        <!-- Detection parameters -->
        <param name="min_contour_area" value="100" type="int"/>
        <param name="max_contour_area" value="50000" type="int"/>
        <!-- Image preprocessing -->
        <param name="blur_kernel_size" value="5" type="int"/>
        <param name="morph_kernel_size" value="3" type="int"/>
        <!-- Box size constraints (meters) -->
        <param name="min_box_size" value="0.02" type="double"/>
        <param name="max_box_size" value="0.5" type="double"/>
        <!-- Valid depth range and depth fallback for non-valid depth readings -->
        <param name="min_depth" value="0.3" type="double"/>
        <param name="max_depth" value="3.0" type="double"/>
        <param name="use_fallback_depth" value="true" type="bool"/>
        <param name="fallback_depth" value="0.3" type="double"/>
        <!-- Debug visualization -->
        <param name="show_debug_image" value="true" type="bool"/>
    </node>

    <!--  **************** Visualisation ****************  -->
    <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find pick_place)/config/find_object.rviz" output="screen"/>
</launch>
