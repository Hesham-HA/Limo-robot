<?xml version="1.0"?>
<launch>
    <param name="use_sim_time" value="true"/>
    <arg name="gazebo_gui" default="true" doc="Start Gazebo GUI"/>
    <arg name="paused" default="false" doc="Start Gazebo paused"/>
    <arg name="world_name" default="$(dirname)/../worlds/office.world" doc="Gazebo world file"/>
    <arg name="world_pose" default="-x 0 -y 0 -z 0.3 -R 0 -P 0 -Y 0" doc="Pose to spawn the robot at"/>
    <arg name="initial_joint_positions" 
    default=" -J grasping_frame_joint 0 -J joint2_to_joint1 0 -J joint3_to_joint2 0 -J joint4_to_joint3 0 -J joint5_to_joint4 0 -J joint6_to_joint5 0 -J joint6output_to_joint6 0" 
    doc="Initial joint configuration of the robot"/>

    <!--  **************** Gazebo-ROS ****************  -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch" pass_all_args="true">
        <arg name="paused" value="true"/> <!-- Start Gazebo paused to allow the controllers to pickup the initial pose -->
        <arg name="verbose" value="true"/>
    </include>

    <!--  **************** Spawn Robot URDF ****************  -->
    <param name="robot_description" textfile="$(find limo_description)/urdf/limo_base.urdf"/>
    <arg name="unpause" value="$(eval '' if arg('paused') else '-unpause')"/>  <!-- Unpause the simulation after loading the robot model -->
    <node name="spawn_gazebo_model" pkg="gazebo_ros" type="spawn_model" args="-urdf -param robot_description -model robot $(arg unpause) $(arg world_pose) $(arg initial_joint_positions)"
    respawn="false" output="screen" />

    <!--  **************** Wheels and Arm Controllers ****************  -->
    <rosparam file="$(find limo_cobot_moveit)/config/gazebo_controllers.yaml" />
    <rosparam file="$(find limo_gazebo_sim)/config/limo_four_diff_control.yaml" command="load"/>
    <include file="$(find limo_cobot_moveit)/launch/ros_controllers.launch"/>
    <node name="gazebo_controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" args="joint_state_controller" />

    <!--  **************** Robot State Publisher (TF) ****************  -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true" output="screen" />
</launch>
